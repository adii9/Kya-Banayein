# Copy this file to .env for local development.
# Both values ship to the browser — that's the whole point of the Supabase anon
# key. RLS on the database is what protects your data, not the secrecy of this
# string. Rotate via Supabase dashboard if you ever leak it on a non-public host.
#
# Vercel: paste these in Project → Settings → Environment Variables for
# Production, Preview, and Development. Do NOT commit a real .env.

VITE_SUPABASE_URL=https://orivktxrtiqggemxetyc.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...2nN8

# Public URL of the deployed app. Share links (voting, WhatsApp, etc.)
# are built from this — voters land on the actual app, not raw Supabase.
# Defaults to https://kya-banayein-theta.vercel.app if unset.
VITE_APP_URL=http://localhost:5173
